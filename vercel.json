{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" } 
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/(.*\\.(png|jpg|jpeg|gif|svg|css|js|ico|woff|woff2|ttf|eot))",
      "dest": "/$1"
    },
    { "src": "/(.*)", "dest": "/index.html" } 
  ]
}
